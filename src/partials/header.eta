<header>
  <nav>
    <h1><%= t('siteName') || 'My Website' %></h1>
    <ul>
      <% for (const loc of alternates) { %>
        <li>
          <a href="<%= getLocalizedUrl(currentPage, loc) %>"<% if (locale === loc) { %> class="active"<% } %>>
            <%= loc.toUpperCase() %>
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
</header>
